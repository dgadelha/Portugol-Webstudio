            "tipo": {
              "primitivo": "inteiro"
            },
            "descrição": "os milissegundos, de 0 a 999. Ex.: 426.\n"
          },
          "parâmetros": []
        },
        {
          "nome": "minuto_atual",
          "descrição": "Retorna os minutos da hora atual do computador",
          "retorno": {
            "tipo": {
              "primitivo": "inteiro"
