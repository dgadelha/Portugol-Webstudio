      "funções": [
        {
          "nome": "ano_atual",
          "descrição": "Retorna o ano da data atual do computador",
          "retorno": {
            "tipo": {
              "primitivo": "inteiro"
            },
            "descrição": "o ano com quatro dígitos. Ex.: 2012.\n"
          },
          "parâmetros": []
        },
        {
          "nome": "dia_mes_atual",
          "descrição": "Retorna o dia do mês da data atual do computador",
          "retorno": {
            "tipo": {
              "primitivo": "inteiro"
            },
            "descrição": "o dia do mês, de 1 a 31. Ex.: 26.\n"
          },
          "parâmetros": []
        },
        {
          "nome": "dia_semana_abreviado",
          "descrição": "Retorna o nome abreviado, com três letras, do dia da semana correspondente ao número informado, de 1 (domingo) a 7 (sábado).\n\nSe o número estiver fora desse intervalo, ocorre um erro de execução.\n",
          "retorno": {
            "tipo": {
              "primitivo": "cadeia"
            },
            "descrição": "o nome abreviado, com três letras, do dia da semana. Ex.: `\"Seg\"`, para segunda-feira.\n"
          },
          "parâmetros": [
            {
              "nome": "numero_dia",
              "tipo": {
                "primitivo": "inteiro"
              },
              "descrição": "o número do dia da semana, de 1 a 7 (use as constantes `DIA_*`)"
            },
            {
              "nome": "caixa_alta",
              "tipo": {
                "primitivo": "logico"
              },
              "descrição": "se `verdadeiro`, o nome é retornado todo em letras maiúsculas"
            },
            {
              "nome": "caixa_baixa",
              "tipo": {
                "primitivo": "logico"
              },
              "descrição": "se `verdadeiro`, o nome é retornado todo em letras minúsculas. Só tem efeito quando `caixa_alta` é `falso`."
            }
          ]
        },
        {
          "nome": "dia_semana_atual",
          "descrição": "Retorna o dia da semana da data atual do computador, de 1 (domingo) a 7 (sábado)",
          "retorno": {
            "tipo": {
              "primitivo": "inteiro"
            },
            "descrição": "o número do dia da semana, que pode ser comparado com as constantes `DIA_*`. Ex.: 1, para domingo.\n"
          },
          "parâmetros": []
        },
        {
          "nome": "dia_semana_completo",
