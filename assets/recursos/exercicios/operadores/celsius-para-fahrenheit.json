{
  "$schema": "https://portugol.dev/esquemas/exercicio/v1.json",
  "id": "pws:celsius-para-fahrenheit",
  "título": "Celsius para Fahrenheit",
  "tópico": "operadores",
  "dificuldade": 1,
  "enunciado": "Leia uma temperatura em graus Celsius, que pode ter casas decimais, e escreva a mesma temperatura em graus Fahrenheit:\n\n$$F = C \\times \\frac{9}{5} + 32$$\n\nO programa pode escrever mensagens antes da leitura, como `Temperatura em Celsius: `, mas o resultado precisa ser escrito como um valor do tipo `real`, sem arredondar.\n\nOs números com casas decimais são digitados com ponto, como em `1.75`.",
  "modo": "avançado",
  "exemplos": [
    {
      "descrição": "água fervendo",
      "entradas": ["100"],
      "verificações": [
        {
          "alvo": "escreva",
          "regra": "contém",
          "valores": [
            {
              "tipo": "real",
              "valor": 212.0
            }
          ]
        }
      ]
    },
    {
      "descrição": "água congelando",
      "entradas": ["0"],
      "verificações": [
        {
          "alvo": "escreva",
          "regra": "contém",
          "valores": [
            {
              "tipo": "real",
              "valor": 32.0
            }
          ]
        }
      ]
    }
  ],
