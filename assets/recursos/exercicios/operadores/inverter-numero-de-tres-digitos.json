{
  "$schema": "https://portugol.dev/esquemas/exercicio/v1.json",
  "id": "pws:inverter-numero-de-tres-digitos",
  "título": "Inverter um número de três dígitos",
  "tópico": "operadores",
  "dificuldade": 3,
  "enunciado": "Leia um número inteiro de três dígitos (de 100 a 999) e escreva o número com os dígitos na ordem inversa. Por exemplo, 136 vira 631.\n\nO resultado precisa ser escrito como um valor do tipo `inteiro`. Por isso, um zero que fica à esquerda some: 120 vira 21, e 100 vira 1.\n\nO programa pode escrever mensagens antes da leitura.",
  "modo": "avançado",
  "exemplos": [
    {
      "descrição": "136",
      "entradas": ["136"],
      "verificações": [
        {
          "alvo": "escreva",
          "regra": "contém",
          "valores": [
            {
              "tipo": "inteiro",
              "valor": 631
            }
          ]
        }
      ]
    }
  ],
