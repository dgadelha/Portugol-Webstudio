{
  "$schema": "https://portugol.dev/esquemas/exercicio/v1.json",
  "id": "pws:horas-minutos-e-segundos",
  "título": "Horas, minutos e segundos",
  "tópico": "operadores",
  "dificuldade": 2,
  "enunciado": "Leia uma duração em segundos (um número inteiro, zero ou positivo) e escreva quantas horas, minutos e segundos ela tem. Por exemplo, 3725 segundos são 1 hora, 2 minutos e 5 segundos.\n\nEscreva as horas, os minutos e os segundos, nesta ordem, como valores do tipo `inteiro`. Os minutos e os segundos vão de 0 a 59; as horas podem passar de 24. O programa pode escrever outros textos junto, como `1 h 2 min 5 s`, e uma mensagem antes da leitura.",
  "modo": "avançado",
  "exemplos": [
    {
      "descrição": "3725 segundos",
      "entradas": ["3725"],
      "verificações": [
        {
          "alvo": "escreva",
          "regra": "contém",
          "valores": [
            {
              "tipo": "inteiro",
              "valor": 1
            },
            {
              "tipo": "inteiro",
              "valor": 2
            },
            {
              "tipo": "inteiro",
              "valor": 5
            }
          ]
        }
      ]
    }
  ],
