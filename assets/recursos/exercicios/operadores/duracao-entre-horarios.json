{
  "$schema": "https://portugol.dev/esquemas/exercicio/v1.json",
  "id": "pws:duracao-entre-horarios",
  "título": "Duração entre dois horários",
  "tópico": "operadores",
  "dificuldade": 3,
  "enunciado": "Leia dois horários, cada um como dois números inteiros, a hora (de 0 a 23) e o minuto (de 0 a 59): primeiro a hora e o minuto do início, depois a hora e o minuto do fim. Escreva quanto tempo passou do início até o fim, em horas e minutos (os minutos de 0 a 59).\n\nO fim pode ser no dia seguinte: de 22:00 até 02:30 passam 4 horas e 30 minutos. Se os dois horários forem iguais, a duração é de 0 horas e 0 minutos.\n\nEscreva as horas e os minutos, nesta ordem, como valores do tipo `inteiro`. O programa pode escrever outros textos junto, e mensagens antes de cada leitura.",
  "modo": "avançado",
  "exemplos": [
    {
      "descrição": "no mesmo dia",
      "entradas": ["8", "30", "17", "15"],
      "verificações": [
        {
          "alvo": "escreva",
          "regra": "contém",
          "valores": [
            {
              "tipo": "inteiro",
              "valor": 8
            },
            {
              "tipo": "inteiro",
              "valor": 45
            }
          ]
        }
      ]
    },
    {
      "descrição": "passando da meia-noite",
      "entradas": ["22", "0", "2", "30"],
      "verificações": [
