{
  "$schema": "https://portugol.dev/esquemas/exercicio/v1.json",
  "id": "pws:contar-ocorrencias",
  "título": "Contar ocorrências",
  "tópico": "vetores",
  "dificuldade": 1,
  "enunciado": "Leia 8 números inteiros e guarde-os num vetor. Depois, leia mais um número inteiro, o número procurado, e escreva quantas vezes ele aparece no vetor. Por exemplo, para os números `3`, `1`, `3`, `5`, `3`, `2`, `8`, `1` e o número procurado `3`, escreva:\n\n```\n3\n```\n\nO programa não deve escrever mais nada: nem mensagens pedindo os dados.",
  "modo": "simples",
  "exemplos": [
    {
      "descrição": "aparece três vezes",
      "entradas": ["3", "1", "3", "5", "3", "2", "8", "1", "3"],
      "saída": "3\n"
    }
  ],
  "testes": [
    {
      "descrição": "não aparece",
      "entradas": ["1", "2", "3", "4", "5", "6", "7", "8", "9"],
      "saída": "0\n"
    },
    {
      "descrição": "aparece em todas as posições",
      "entradas": ["0", "0", "0", "0", "0", "0", "0", "0", "0"],
      "saída": "8\n"
    },
    {
      "descrição": "aparece só na primeira e na última posição",
      "entradas": ["6", "1", "2", "3", "4", "5", "7", "6", "6"],
      "saída": "2\n"
    },
    {
      "descrição": "número negativo",
      "entradas": ["-1", "1", "-1", "1", "-1", "1", "-1", "1", "-1"],
      "saída": "4\n"
    },
    {
      "descrição": "aparece só na primeira posição",
      "entradas": ["5", "1", "2", "3", "4", "6", "7", "8", "5"],
      "saída": "1\n"
    },
    {
      "descrição": "aparece só na última posição",
      "entradas": ["1", "2", "3", "4", "5", "6", "7", "9", "9"],
      "saída": "1\n"
    },
    {
      "descrição": "procura o zero",
      "entradas": ["3", "0", "4", "0", "5", "0", "6", "1", "0"],
      "saída": "3\n"
    },
    {
      "descrição": "números grandes",
      "entradas": ["100000", "99999", "100000", "1", "2", "3", "100000", "4", "100000"],
      "saída": "3\n"
    }
  ]
}
