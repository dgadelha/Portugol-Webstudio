      "descrição": "um número só",
      "entradas": ["1", "3"],
      "saída": "3\n"
    },
    {
      "descrição": "já em ordem",
      "entradas": ["5", "1", "2", "3", "4", "5"],
      "saída": "1\n2\n3\n4\n5\n"
    },
    {
      "descrição": "em ordem decrescente",
      "entradas": ["5", "9", "7", "5", "3", "1"],
      "saída": "1\n3\n5\n7\n9\n"
    },
    {
      "descrição": "números repetidos",
