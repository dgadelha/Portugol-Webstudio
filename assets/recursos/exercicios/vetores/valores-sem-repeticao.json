  "$schema": "https://portugol.dev/esquemas/exercicio/v1.json",
  "id": "pws:valores-sem-repeticao",
  "título": "Valores sem repetição",
  "tópico": "vetores",
  "dificuldade": 2,
  "enunciado": "Leia um número inteiro $n$, de 1 a 100, e depois $n$ números inteiros. Escreva cada valor diferente uma vez só, na ordem em que ele apareceu pela primeira vez, um por linha. Por exemplo, para $n = 6$ e os números `3`, `1`, `3`, `2`, `1`, `5`:\n\n```\n3\n1\n2\n5\n```\n\nO programa não deve escrever mais nada: nem mensagens pedindo os dados.",
  "modo": "simples",
  "exemplos": [
    {
      "descrição": "com repetições",
      "entradas": ["6", "3", "1", "3", "2", "1", "5"],
      "saída": "3\n1\n2\n5\n"
    }
  ],
