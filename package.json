{
  "name": "portugol-webstudio",
  "description": "IDE online para o Portugol",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgadelha/Portugol-Webstudio.git"
  },
  "keywords": [
    "portugol",
    "webstudio"
  ],
  "author": "Douglas Gadêlha <dgadelha@live.com>",
  "contributors": [
    "Danilo Gadêlha <dngadelha@outlook.com>"
  ],
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/dgadelha/Portugol-Webstudio/issues"
  },
  "homepage": "https://github.com/dgadelha/Portugol-Webstudio#readme",
  "packageManager": "npm@12.2.0+sha512.66c2632a94e796649738b2d7894d710c2cc2e1696893823066687f6b0d8a52e5f2b54eeaeaa32ffdc513ecca1e49ff794a5c2ec3f9515d879f1b3182b291cf35",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "sherif && npm run eslint:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eslint:fix": "eslint --fix .",
    "eslint:check": "eslint .",
    "typecheck": "lerna run typecheck",
    "start": "lerna run start --scope=@portugol-webstudio/ide",
    "build": "lerna run build",
    "build:w": "lerna run --parallel build:w",
    "changelog:entry": "node .github/scripts/changelog.mjs new",
    "build:parser": "lerna run build --scope=@portugol-webstudio/parser",
    "build:runner": "lerna run build --scope=@portugol-webstudio/runner",
    "build:runtime": "lerna run build --scope=@portugol-webstudio/runtime",
    "test:parser": "lerna run test --scope=@portugol-webstudio/parser",
    "test:runner": "lerna run test --scope=@portugol-webstudio/runner",
    "release": "lerna run release",
    "postinstall": "patch-package",
    "test": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^77.0.0",
    "lerna": "^10.0.1",
    "patch-package": "^8.0.1",
    "sherif": "^1.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "@angular/build": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/fire": {
      "typescript": "$typescript"
    },
    "@nx/devkit": {
      "minimatch": "^10.2.3"
    },
    "@sentry/angular": {
      "@angular/router": "^22.1.5"
    },
    "tmp": "^0.2.5",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.2": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "nx@23.2.0": true,
    "protobufjs@7.6.6": true
  }
}
