    {
      "nome": "Graficos",
      "descrição": "Esta biblioteca permite inicializar e utilizar um ambiente gráfico com suporte ao desenho de primitivas gráficas e de imagens carregadas do sistema de arquivos",
      "constantes": [
        {
          "nome": "CANAL_B",
