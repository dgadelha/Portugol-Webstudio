{
  "name": "@portugol-webstudio/resources",
  "description": "Recursos do Portugol Webstudio: a Ajuda, os exemplos, os exercícios e os metadados das bibliotecas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgadelha/Portugol-Webstudio.git"
  },
  "keywords": [
    "portugol",
    "webstudio"
  ],
  "author": "Douglas Gadêlha <dgadelha@live.com>",
  "contributors": [
    "Danilo Gadêlha <dngadelha@outlook.com>"
  ],
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/dgadelha/Portugol-Webstudio/issues"
  },
  "homepage": "https://github.com/dgadelha/Portugol-Webstudio#readme",
  "exports": {
    "./bibliotecas": {
      "types": "./bibliotecas/index.d.ts",
      "default": "./bibliotecas/index.js"
    },
    "./ajuda/*": "./ajuda/*",
    "./exemplos/*": "./exemplos/*",
    "./exercicios": {
      "types": "./exercicios/index.d.ts",
      "default": "./exercicios/index.json"
    },
    "./exercicios/esquema": {
      "types": "./exercicios/esquema.d.ts",
      "default": "./exercicios/esquema.js"
    },
    "./exercicios/*": "./exercicios/*",
    "./esquemas/*": "./esquemas/*"
  },
  "scripts": {
    "build": "node bibliotecas/scripts/build.js && node exercicios/scripts/build.js"
  },
  "devDependencies": {
    "yaml": "^2.9.1",
    "zod-to-ts": "^2.1.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
