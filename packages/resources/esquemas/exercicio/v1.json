{
  "$id": "https://portugol.dev/esquemas/exercicio/v1.json",
  "title": "Exercício do Portugol Webstudio",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "https://portugol.dev/esquemas/exercicio/v1.json"
        },
        "id": {
          "type": "string",
          "pattern": "^pws:[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Identificador estável: 'pws:<slug>' nos exercícios embutidos. Nunca muda"
        },
        "título": {
          "type": "string",
          "minLength": 1
        },
        "tópico": {
          "type": "string",
          "enum": [
            "saida",
            "entrada-e-variaveis",
            "operadores",
            "condicionais",
            "escolha",
            "lacos",
            "vetores",
            "matrizes",
            "funcoes"
          ]
        },
        "dificuldade": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 3
            }
          ],
          "description": "1: fácil, 2: médio, 3: difícil"
        },
        "enunciado": {
          "type": "string",
          "minLength": 1,
          "description": "Markdown sem HTML; fórmulas entre $ ou $$"
        },
        "códigoInicial": {
          "description": "Código que o aluno recebe ao abrir o exercício",
          "type": "string"
        },
        "solução": {
          "type": "string",
          "minLength": 1,
          "description": "Solução de referência: gera as saídas e é conferida no CI"
        },
        "atribuição": {
          "description": "Fonte e licença, quando o exercício foi adaptado de perto de outro",
          "type": "object",
          "properties": {
            "fonte": {
              "type": "string",
              "minLength": 1
            },
            "licença": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "fonte",
            "licença"
          ],
          "additionalProperties": false
        },
        "modo": {
          "type": "string",
          "const": "simples",
          "description": "Compara o texto escrito, linha a linha"
        },
        "exemplos": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "descrição": {
                "description": "Descrição curta, mostrada no resultado: \"teste 8 (números negativos)\"",
                "type": "string",
                "minLength": 1
              },
              "entradas": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "O que cada 'leia' recebe, na ordem, como se fosse digitado"
              },
              "saída": {
                "type": "string",
                "description": "O texto escrito pela solução de referência (gerado, não editar à mão)"
              }
            },
            "required": [
              "entradas",
              "saída"
            ],
            "additionalProperties": false
          }
        },
        "testes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "descrição": {
                "description": "Descrição curta, mostrada no resultado: \"teste 8 (números negativos)\"",
                "type": "string",
                "minLength": 1
              },
              "entradas": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "O que cada 'leia' recebe, na ordem, como se fosse digitado"
              },
              "saída": {
                "type": "string",
                "description": "O texto escrito pela solução de referência (gerado, não editar à mão)"
              }
            },
            "required": [
              "entradas",
              "saída"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "$schema",
        "id",
        "título",
        "tópico",
        "dificuldade",
        "enunciado",
        "solução",
        "modo",
        "exemplos",
        "testes"
      ],
      "additionalProperties": false
    },
