      "entradas": ["3"],
      "saída": "11\n"
    },
    {
      "descrição": "outra potência de dois pequena",
      "entradas": ["4"],
      "saída": "100\n"
    },
    {
      "descrição": "bits alternados, número pequeno",
      "entradas": ["5"],
      "saída": "101\n"
    },
    {
      "descrição": "bits ligados no começo",
      "entradas": ["6"],
      "saída": "110\n"
