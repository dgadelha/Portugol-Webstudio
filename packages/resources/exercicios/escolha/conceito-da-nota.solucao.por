programa {
  funcao inicio() {
    inteiro nota

    leia(nota)

    escolha (nota) {
      caso 10:
      caso 9:
        escreva("A\n")
        pare
      caso 8:
      caso 7:
        escreva("B\n")
        pare
      caso 6:
      caso 5:
        escreva("C\n")
        pare
      caso 4:
      caso 3:
      caso 2:
      caso 1:
      caso 0:
        escreva("D\n")
        pare
      caso contrario:
        escreva("nota inválida\n")
    }
  }
}
