programa {
  funcao inicio() {
    inteiro dia

    leia(dia)

    escolha (dia) {
      caso 1:
        escreva("domingo\n")
        pare
      caso 2:
        escreva("segunda\n")
        pare
      caso 3:
        escreva("terça\n")
        pare
      caso 4:
        escreva("quarta\n")
        pare
      caso 5:
        escreva("quinta\n")
        pare
      caso 6:
        escreva("sexta\n")
        pare
      caso 7:
        escreva("sábado\n")
        pare
      caso contrario:
        escreva("dia inválido\n")
    }
  }
}
