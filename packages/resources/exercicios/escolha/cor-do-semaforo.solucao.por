programa {
  funcao inicio() {
    caracter cor

    leia(cor)

    escolha (cor) {
      caso 'v':
      caso 'V':
        escreva("siga\n")
        pare
      caso 'a':
      caso 'A':
        escreva("atenção\n")
        pare
      caso 'r':
      caso 'R':
        escreva("pare\n")
        pare
      caso contrario:
        escreva("cor inválida\n")
    }
  }
}
