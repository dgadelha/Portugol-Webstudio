programa {
  funcao inicio() {
    inteiro mes

    leia(mes)

    escolha (mes) {
      caso 1:
      caso 3:
      caso 5:
      caso 7:
      caso 8:
      caso 10:
      caso 12:
        escreva("31\n")
        pare
      caso 4:
      caso 6:
      caso 9:
      caso 11:
        escreva("30\n")
        pare
      caso 2:
        escreva("28\n")
        pare
      caso contrario:
        escreva("mês inválido\n")
    }
  }
}
